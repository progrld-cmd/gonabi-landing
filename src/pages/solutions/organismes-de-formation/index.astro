---
import PageLayout from '../../../layouts/PageLayout.astro';
import PlaceholderSection from '../../../components/PlaceholderSection.astro';
import CtaBand from '../../../components/CtaBand.astro';
---

<PageLayout
  title="Gonabi pour les organismes de formation"
  description="[À FOURNIR] Meta description — Gonabi pour les organismes de formation, 150 à 160 caractères."
  heading="Gonabi pour les organismes de formation"
  eyebrow="Solutions"
  lead="[À FOURNIR] Chapô : l'enjeu principal des organismes de formation, formulé avec leurs mots."
  breadcrumbs={[
    { label: 'Solutions', href: '/solutions' },
    { label: 'Organismes de formation' },
  ]}
>
  <PlaceholderSection
    title="Vos enjeux"
    brief="Trois freins spécifiques à cette cible, issus d'entretiens clients réels."
    items={['Enjeu 1', 'Enjeu 2', 'Enjeu 3']}
    tone="cream-light"
  />

  <PlaceholderSection
    title="Ce que Gonabi change"
    brief="Relier chaque enjeu à une brique produit, avec un lien vers la page correspondante."
    tone="cream"
  />

  <PlaceholderSection
    title="Traçabilité et conformité"
    brief="Renvoyer vers la page Conformité Qualiopi sans dupliquer son contenu."
    tone="white"
  >
    <p class="solution-more"><a href="/produit/conformite-qualiopi">Conformité Qualiopi</a></p>
  </PlaceholderSection>

  <CtaBand />
</PageLayout>

<style>
  .solution-more {
    margin-top: var(--gnb-space-6);
  }

  .solution-more a {
    color: var(--gnb-red);
    font-weight: 600;
  }
</style>
