---
import PageLayout from '../../../layouts/PageLayout.astro';
import PlaceholderSection from '../../../components/PlaceholderSection.astro';
import CtaBand from '../../../components/CtaBand.astro';
---

<PageLayout
  title="Explorateur de métiers"
  description="[À FOURNIR] Meta description — exploration des métiers et des pistes d'évolution, 150 à 160 caractères."
  heading="Explorateur de métiers"
  eyebrow="Produit"
  lead="[À FOURNIR] Chapô : passer du profil aux pistes concrètes de métiers."
  breadcrumbs={[{ label: 'Produit', href: '/produit' }, { label: 'Explorateur de métiers' }]}
>
  <PlaceholderSection
    title="Explorer à partir du profil"
    brief="Expliquer comment les résultats du bénéficiaire alimentent les suggestions de métiers."
    tone="cream-light"
  />

  <PlaceholderSection
    title="Les données métiers"
    brief="Préciser le référentiel métiers utilisé et sa source. Ne pas inventer de volumétrie."
    tone="cream"
  />

  <PlaceholderSection
    title="De la piste au plan d'action"
    brief="Décrire le passage d'un métier exploré à une étape de parcours."
    tone="white"
  />

  <CtaBand />
</PageLayout>
