---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { DEMO_HREF, mainNav } from '../data/navigation';
import type { IconName } from '../components/Icon.astro';

const produit = mainNav.find((group) => group.label === 'Produit');
const solutions = mainNav.find((group) => group.label === 'Solutions');
const segments = solutions?.children?.filter((page) => page.href.startsWith('/solutions/')) ?? [];

const partenaires = [
  { src: '/assets/partners/missions_locales_grayscale.png', alt: 'Missions Locales' },
  { src: '/assets/partners/aura_grayscale.png', alt: 'Région Auvergne-Rhône-Alpes' },
  { src: '/assets/partners/cma_grayscale.png', alt: 'Chambre de Métiers et de l’Artisanat' },
  { src: '/assets/partners/edlv_grayscale.png', alt: 'EDLV' },
  { src: '/assets/partners/french_tech_grayscale.png', alt: 'French Tech' },
];

/**
 * Les trois arguments du hero. Chacun est sourcé :
 * - centralisation : hypothèse n°1 validée en bêta (« la centralisation est la clé »)
 * - preuves Qualiopi : PRD Conformité Qualiopi v1.1, sprint 1 livré
 * - personnalisation : besoin fondamental relevé en entretien de clôture bêta
 * Ne pas y remettre l'IA : aucune limite n'est contractualisée (voir navigation.ts).
 */
const reassurances: { icone: IconName; texte: string }[] = [
  { icone: 'layers', texte: 'Vos outils réunis en un seul' },
  { icone: 'shield-check', texte: 'Vos preuves Qualiopi générées par l’accompagnement' },
  { icone: 'compass', texte: 'Vos ressources, vos trames, votre méthode' },
];

/** Repris de l'ancienne landing : la partie du titre qui change en fondu. */
const rotations = [
  { texte: 'en orientation.', couleur: 'blue' },
  { texte: 'en évolution professionnelle.', couleur: 'red' },
  { texte: 'en bilan de compétences.', couleur: 'ochre' },
];

// Freins tirés de verbatims de bêta-testeurs, pas de suppositions.
const freins = [
  {
    titre: 'Vous saisissez la même chose trois fois',
    texte:
      'Un outil pour les tests, un logiciel pour l’administratif, un serveur partagé pour les documents, un traitement de texte pour les synthèses. Ce que vous entrez quelque part, vous le ressaisissez ailleurs.',
  },
  {
    titre: 'L’administratif répétitif grignote vos journées',
    texte:
      'Envoyer un contrat, retrouver un document, remettre en forme une synthèse, convenir d’une date. Autant de temps qui ne va ni au bénéficiaire, ni à de nouveaux dossiers.',
  },
  {
    titre: 'Les preuves se reconstituent la veille de l’audit',
    texte:
      'Retrouver qui a signé quoi, quand, sur quelle séance. Nos bêta-testeurs estimaient y passer 2 à 4 heures par audit — un travail refait à chaque cycle.',
  },
];

// Différenciateurs issus du benchmark concurrentiel du PRD Conformité Qualiopi.
const differences = [
  {
    titre: 'Un outil là où il en fallait quatre',
    texte:
      'Les tests dans un catalogue, les métiers dans un autre abonnement, l’administratif dans un logiciel de gestion, les synthèses dans un traitement de texte. Gonabi tient les quatre.',
  },
  {
    titre: 'La conformité naît de l’accompagnement',
    texte:
      'Les autres outils qualité vous demandent de saisir vos preuves dans un module à part. Ici, la séance que vous menez les produit.',
  },
  {
    titre: 'Votre méthode reste la vôtre',
    texte:
      'Vos ressources, vos trames de parcours, vos supports. L’outil structure votre pratique, il ne la remplace pas par la sienne.',
  },
];

const confiance: { icone: IconName; titre: string; texte: string }[] = [
  {
    icone: 'eye-off',
    titre: 'Vos séances ne sont pas enregistrées',
    texte: 'Ni audio, ni vidéo. Seule la connexion à la plateforme est journalisée.',
  },
  {
    icone: 'lock',
    titre: 'Les dossiers sont cloisonnés',
    texte: 'L’accès est limité à l’organisation et au parcours suivi.',
  },
  {
    icone: 'file-text',
    titre: 'Les preuves sont conservées 5 ans',
    texte: 'La durée pendant laquelle un dossier financé peut être contrôlé.',
  },
];
---

<BaseLayout
  title="Gonabi"
  description="Gonabi réunit tests psychométriques, parcours, exploration métiers, synthèses et preuves Qualiopi dans un seul outil, pour les cabinets RH et les organismes de formation."
  canonical="/"
>
  <!-- ══════════════ HERO — asymétrique, aligné à gauche ══════════════ -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__content">
        <p class="eyebrow hero__eyebrow">Plateforme d’accompagnement professionnel</p>

        <h1 class="hero__title">
          La plateforme qui structure, automatise et valorise vos accompagnements
          <span class="rotator">
            {
              rotations.map((r, i) => (
                <span
                  class:list={['rotator__item', `is-${r.couleur}`]}
                  style={`--step: ${i}`}
                >
                  {r.texte}
                </span>
              ))
            }
          </span>
        </h1>

        <p class="lead hero__lead">
          Créez des parcours sur mesure, automatisez les tâches répétitives et gérez vos suivis en
          temps réel, au même endroit.
        </p>

        <div class="hero__actions">
          <a href={DEMO_HREF} class="btn btn--primary">Réserver une démo</a>
          <a href="/produit" class="btn btn--secondary">Découvrir la solution</a>
        </div>

        <ul class="hero__badges">
          {
            reassurances.map((item) => (
              <li>
                <Icon name={item.icone} size={17} />
                {item.texte}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="hero__visual">
        <img
          src="/assets/images/Hero_visual.png"
          alt="Interface Gonabi : tableau de bord, profil psychométrique et parcours personnalisés"
          width="760"
          height="570"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- ══════════════ PARTENAIRES — bandeau fin cerné de filets ══════════════ -->
  <section class="partners">
    <div class="container partners__inner">
      <p class="eyebrow partners__label">Ils nous font confiance</p>
      <ul class="partners__row">
        {
          partenaires.map((p) => (
            <li>
              <img src={p.src} alt={p.alt} loading="lazy" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ══════════════ FREINS — rangées numérotées, pas de cartes ══════════════ -->
  <section class="section section--paper">
    <div class="container">
      <header class="block-head" data-reveal>
        <p class="eyebrow eyebrow--rule">Le constat</p>
        <h2 class="block-head__title">Ce qui vous freine aujourd’hui</h2>
      </header>

      <ol class="figures">
        {
          freins.map((frein, i) => (
            <li class="figure" data-reveal>
              <span class="numeral figure__num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="figure__title">{frein.titre}</h3>
              <p class="figure__text">{frein.texte}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ══════════════ TÉMOIGNAGE — bande courte, rythme à part ══════════════ -->
  <section class="section section--tight section--paper-light">
    <div class="container">
      <figure class="quote" data-reveal>
        <blockquote class="quote__text">
          Avant, je passais mes jeudis soirs à rédiger mes synthèses. Maintenant, je génère un
          rapport complet en trois clics pendant la séance. Mes jeudis soirs m’appartiennent à
          nouveau.
        </blockquote>
        <figcaption class="quote__source">
          Coach en reconversion · bêta-testeuse · six accompagnements en parallèle
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ══════════════ PRODUIT — pleine page encre, index éditorial ══════════════ -->
  <section class="section section--ink produit">
    <div class="container produit__grid">
      <div class="produit__aside">
        <p class="eyebrow eyebrow--rule">Le produit</p>
        <h2 class="produit__title">Tout l’accompagnement dans un seul outil</h2>
        <p class="lead produit__lead">
          Chaque brique alimente la suivante : les tests nourrissent l’exploration métiers, le
          parcours produit ses preuves, et la synthèse se rédige à partir de tout ce qui précède.
        </p>
        <a href="/produit" class="link-arrow produit__all">
          Voir la vue d’ensemble
          <Icon name="arrow-right" size={16} />
        </a>
      </div>

      <ul class="index-list">
        {
          produit?.children?.map((page) => (
            <li>
              <a href={page.href} class="index-row">
                <span class="index-row__label">{page.label}</span>
                <span class="index-row__desc">{page.description}</span>
                <Icon name="arrow-up-right" size={18} class="index-row__icon" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ══════════════ SEGMENTS — titre à gauche, grille 2×2 à droite ══════════════ -->
  <section class="section section--paper">
    <div class="container segments__grid">
      <div class="segments__aside" data-reveal>
        <p class="eyebrow eyebrow--rule">Pour qui</p>
        <h2 class="segments__title">Conçu d’abord pour les structures de 8 à 25&nbsp;consultants</h2>
        <p class="segments__note">
          Cabinets RH et organismes de formation qui accompagnent en bilan de compétences,
          évolution professionnelle ou orientation.
        </p>
      </div>

      <div class="segments__list">
        {
          segments.map((page) => (
            <a href={page.href} class="segment" data-reveal>
              <h3 class="segment__title">{page.label}</h3>
              <p class="segment__text">{page.description}</p>
              <span class="segment__more" aria-hidden="true">
                <Icon name="arrow-right" size={16} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ══════════════ DIFFÉRENCIATION — trois colonnes séparées de filets ══════════════ -->
  <section class="section section--paper-light">
    <div class="container">
      <header class="block-head block-head--wide" data-reveal>
        <p class="eyebrow eyebrow--rule">La différence</p>
        <h2 class="block-head__title">Trois choix que nous assumons</h2>
      </header>

      <div class="columns">
        {
          differences.map((item, i) => (
            <article class="column" data-reveal>
              <span class="numeral column__num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="column__title">{item.titre}</h3>
              <p class="column__text">{item.texte}</p>
            </article>
          ))
        }
      </div>

      <p class="columns__after">
        <a href="/produit/syntheses-ia" class="link-arrow">
          Voir comment se génère une synthèse
          <Icon name="arrow-right" size={16} />
        </a>
      </p>
    </div>
  </section>

  <!-- ══════════════ MIGRATION — citation en exergue ══════════════ -->
  <section class="section section--paper migration">
    <div class="container migration__grid">
      <blockquote class="pull" data-reveal>
        <p class="pull__quote">« Encore une plateforme de plus à gérer ? »</p>
        <footer class="pull__source">
          La première objection que nous entendons, relevée en entretien de clôture bêta.
        </footer>
      </blockquote>

      <div class="migration__body" data-reveal>
        <p>
          Elle est juste : un outil qui s’ajoute aux autres sans en remplacer aucun fait perdre du
          temps au lieu d’en gagner.
        </p>
        <p>
          C’est pourquoi nous commençons toujours par regarder ce que Gonabi remplace chez vous —
          et ce qu’il ne remplacera pas.
        </p>
        <a href="/migrer-vers-gonabi" class="link-arrow">
          Migrer vers Gonabi
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════ CONFIANCE — texte à gauche, liste à droite ══════════════ -->
  <section class="section section--paper-light">
    <div class="container trust__grid">
      <div data-reveal>
        <p class="eyebrow eyebrow--rule">Confiance</p>
        <h2 class="trust__title">Des données sensibles, traitées comme telles</h2>
        <p class="lead trust__lead">
          Un bilan de compétences produit des informations intimes, protégées par la loi. Nous
          documentons publiquement ce que nous en faisons — et ce que nous nous interdisons.
        </p>
        <a href="/a-propos/securite-rgpd" class="link-arrow">
          Sécurité &amp; RGPD
          <Icon name="arrow-right" size={16} />
        </a>
      </div>

      <ul class="trust__list">
        {
          confiance.map((item) => (
            <li class="trust__item" data-reveal>
              <Icon name={item.icone} size={22} class="trust__icon" />
              <div>
                <h3 class="trust__item-title">{item.titre}</h3>
                <p class="trust__item-text">{item.texte}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ══════════════ CTA FINAL — bandeau encre, composition large ══════════════ -->
  <section class="section section--ink cta">
    <div class="container cta__grid">
      <h2 class="cta__title">Voir Gonabi tourner sur vos propres cas</h2>
      <div class="cta__side">
        <p class="cta__text">
          Une démonstration guidée, adaptée à votre structure et à vos accompagnements.
        </p>
        <a href={DEMO_HREF} class="btn btn--primary">Réserver une démo</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ════════════════════════ HERO ════════════════════════ */

  .hero {
    background: var(--paper);
    padding-block: clamp(48px, 7vw, 112px) clamp(56px, 8vw, 128px);
    overflow: hidden;
  }

  .hero__grid {
    display: grid;
    /* La colonne texte est la plus large : un H1 à 68px a besoin de place, sinon
       il part sur huit lignes. Le visuel compense en débordant hors du conteneur
       jusqu'au bord de l'écran. */
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--space-16);
    align-items: center;
  }

  .hero__eyebrow {
    margin-bottom: var(--space-8);
  }

  .hero__title {
    max-width: 15ch;
    margin-bottom: var(--space-8);
  }

  /*
   * Carrousel du titre, repris de l'ancienne landing. Trois états qui se
   * succèdent en fondu, en CSS pur — les trois textes restent dans le DOM,
   * donc lisibles par un lecteur d'écran et indexables.
   */
  .rotator {
    display: block;
    position: relative;
    min-height: 1.15em;
  }

  .rotator__item {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    opacity: 0;
    animation: rotator 10.5s infinite;
    /* --step porte le rang de l'élément : 0, 1 puis 2 */
    animation-delay: calc(var(--step) * 3.5s);
  }

  .rotator__item.is-blue {
    color: var(--blue-deep);
  }
  .rotator__item.is-red {
    color: var(--accent);
  }
  .rotator__item.is-ochre {
    color: var(--ochre);
  }

  @keyframes rotator {
    0%,
    2% {
      opacity: 0;
    }
    5%,
    28% {
      opacity: 1;
    }
    33%,
    100% {
      opacity: 0;
    }
  }

  /* Mouvement réduit : on fige sur le premier état plutôt que de faire clignoter */
  @media (prefers-reduced-motion: reduce) {
    .rotator__item {
      animation: none;
    }
    .rotator__item:first-child {
      opacity: 1;
    }
  }

  .hero__lead {
    max-width: 46ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .hero__badges {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-8);
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: var(--border-hairline) solid var(--rule);
  }

  .hero__badges li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    letter-spacing: 0.005em;
    color: var(--text-muted);
  }

  .hero__badges :global(svg) {
    color: var(--accent);
    flex-shrink: 0;
  }

  /*
   * Le visuel sort du conteneur et va jusqu'au bord droit de l'écran : c'est la
   * grille brisée qui donne son caractère au hero. Sous 1200px le calcul retombe
   * naturellement sur un simple débord de gouttière. `overflow: hidden` sur
   * `.hero` empêche tout défilement horizontal.
   */
  .hero__visual {
    position: relative;
    margin-right: calc((100vw - min(100vw, var(--container))) / -2 - var(--gutter));
  }

  .hero__visual img {
    width: 100%;
    border-radius: var(--radius-lg);
  }

  /* Apparition au chargement, échelonnée */
  @media (prefers-reduced-motion: no-preference) {
    .hero__eyebrow,
    .hero__title,
    .hero__lead,
    .hero__actions,
    .hero__badges,
    .hero__visual {
      animation: rise 620ms var(--ease) backwards;
    }
    .hero__eyebrow {
      animation-delay: 40ms;
    }
    .hero__title {
      animation-delay: 100ms;
    }
    .hero__lead {
      animation-delay: 180ms;
    }
    .hero__actions {
      animation-delay: 250ms;
    }
    .hero__badges {
      animation-delay: 310ms;
    }
    .hero__visual {
      animation-delay: 160ms;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ════════════════════════ PARTENAIRES ════════════════════════ */

  .partners {
    background: var(--paper-light);
    border-block: var(--border-hairline) solid var(--rule);
  }

  .partners__inner {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    padding-block: var(--space-8);
  }

  .partners__label {
    flex-shrink: 0;
    color: var(--ink-40);
  }

  .partners__row {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: 1;
    gap: var(--space-8);
  }

  .partners__row img {
    height: 26px;
    width: auto;
    opacity: 0.5;
    filter: grayscale(1);
    transition: opacity var(--duration) var(--ease);
  }

  .partners__row img:hover {
    opacity: 0.85;
  }

  /* ════════════════════════ EN-TÊTES DE BLOC ════════════════════════ */

  .block-head {
    max-width: 720px;
    margin-bottom: var(--space-24);
  }

  .block-head--wide {
    max-width: 900px;
  }

  .block-head__title {
    margin-top: var(--space-8);
  }

  /* ════════════════════════ FREINS ════════════════════════ */

  .figures {
    list-style: none;
  }

  .figure {
    display: grid;
    grid-template-columns: 110px minmax(0, 4fr) minmax(0, 6fr);
    gap: var(--space-8);
    align-items: start;
    padding-block: var(--space-16);
    border-top: var(--border-hairline) solid var(--rule);
  }

  .figure:last-child {
    border-bottom: var(--border-hairline) solid var(--rule);
  }

  .figure__num {
    /* Aligne l'œil du chiffre sur la ligne de base du titre */
    margin-top: -0.12em;
  }

  .figure__title {
    font-size: var(--size-h3);
  }

  .figure__text {
    color: var(--text-muted);
    max-width: 56ch;
  }

  /* ════════════════════════ TÉMOIGNAGE ════════════════════════ */

  .quote {
    max-width: 900px;
    position: relative;
    padding-left: clamp(32px, 5vw, 64px);
  }

  /* Guillemet ouvrant en très grand, traité comme un ornement typographique */
  .quote::before {
    content: '«';
    position: absolute;
    left: 0;
    top: -0.12em;
    font-family: var(--font-display);
    font-size: clamp(3rem, 6vw, 5rem);
    line-height: 1;
    color: var(--accent);
  }

  .quote__text {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.6vw, 2rem);
    font-weight: var(--weight-regular);
    font-style: italic;
    line-height: 1.35;
    letter-spacing: var(--tracking-snug);
    color: var(--text);
  }

  .quote__source {
    margin-top: var(--space-8);
    font-size: var(--size-small);
    color: var(--text-muted);
  }

  /* ════════════════════════ PRODUIT (encre) ════════════════════════ */

  .produit__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-16);
    align-items: start;
  }

  .produit__aside {
    position: sticky;
    top: 120px;
  }

  /* Titre de colonne latérale : il ne peut pas suivre l'échelle des H2 de
     pleine largeur, « l'accompagnement » déborderait de sa colonne. */
  .produit__title {
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    margin-top: var(--space-8);
    margin-bottom: var(--space-8);
    max-width: 14ch;
  }

  .produit__lead {
    max-width: 42ch;
  }

  .produit__all {
    margin-top: var(--space-8);
  }

  .index-list {
    list-style: none;
    border-top: var(--border-hairline) solid var(--on-ink-rule);
  }

  .index-row {
    display: grid;
    /* Colonnes à parts égales : en 5fr/7fr, « Portefeuille de compétences »
       déborde de sa colonne juste au-dessus du point de bascule à 1024px. */
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr) 24px;
    gap: var(--space-8);
    align-items: baseline;
    padding: var(--space-8) var(--space-4) var(--space-8) 0;
    border-bottom: var(--border-hairline) solid var(--on-ink-rule);
    text-decoration: none;
    transition:
      padding-left var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  .index-row:hover {
    padding-left: var(--space-4);
