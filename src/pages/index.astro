---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ShapeMask from '../components/ShapeMask.astro';
import IconBadge from '../components/IconBadge.astro';
import type { ShapeVariant } from '../components/ShapeMask.astro';
import { DEMO_HREF, mainNav } from '../data/navigation';

const produit = mainNav.find((group) => group.label === 'Produit');
const solutions = mainNav.find((group) => group.label === 'Pour qui');
const segments = solutions?.children?.filter((page) => page.href.startsWith('/solutions/')) ?? [];

const partenaires = [
  { src: '/assets/partners/missions_locales_grayscale.png', alt: 'Missions Locales' },
  { src: '/assets/partners/aura_grayscale.png', alt: 'Région Auvergne-Rhône-Alpes' },
  { src: '/assets/partners/cma_grayscale.png', alt: 'Chambre de Métiers et de l’Artisanat' },
  { src: '/assets/partners/edlv_grayscale.png', alt: 'EDLV' },
  { src: '/assets/partners/french_tech_grayscale.png', alt: 'French Tech' },
];

/** Puces sous le CTA hero — formes du logo, pas d'icônes pictogrammes. */
const reassurances: { shape: ShapeVariant; color: string; texte: string }[] = [
  { shape: 'block-round', color: 'var(--blue)', texte: 'Vos outils réunis en un seul' },
  { shape: 'arc-concave', color: 'var(--accent)', texte: 'Vos preuves Qualiopi générées par l’accompagnement' },
  { shape: 'half-disc', color: 'var(--ochre)', texte: 'Vos ressources, vos trames, votre méthode' },
];

/** Repris de l'ancienne landing : la partie du titre qui change en fondu. */
const rotations = [
  { texte: 'en orientation.', couleur: 'blue' },
  { texte: 'en évolution professionnelle.', couleur: 'red' },
  { texte: 'en bilan de compétences.', couleur: 'ochre' },
];

const heroTiles = [
  { icon: 'layers' as const, label: 'Tableau de bord' },
  { icon: 'file-text' as const, label: 'Synthèse IA' },
];

// Freins tirés de verbatims de bêta-testeurs. Traitement en rangées à
// séparateurs fins et marqueur rond — pas de photo : ce sont des constats de
// douleur, pas des preuves de fonctionnalité, et une photo de personne
// « stressée » serait un cliché fabriqué de toutes pièces.
const freins = [
  {
    titre: 'Vous saisissez la même chose trois fois',
    texte:
      'Un outil pour les tests, un logiciel pour l’administratif, un serveur partagé pour les documents, un traitement de texte pour les synthèses. Ce que vous entrez quelque part, vous le ressaisissez ailleurs.',
  },
  {
    titre: 'L’administratif répétitif grignote vos journées',
    texte:
      'Envoyer un contrat, retrouver un document, remettre en forme une synthèse, convenir d’une date. Autant de temps qui ne va ni au bénéficiaire, ni à de nouveaux dossiers.',
  },
  {
    titre: 'Les preuves se reconstituent la veille de l’audit',
    texte:
      'Retrouver qui a signé quoi, quand, sur quelle séance. Nos bêta-testeurs estimaient y passer 2 à 4 heures par audit — un travail refait à chaque cycle.',
  },
];

// Différenciateurs issus du benchmark concurrentiel du PRD Conformité Qualiopi.
const differences: { titre: string; texte: string; shape: ShapeVariant; color: string }[] = [
  {
    titre: 'Un outil là où il en fallait quatre',
    texte:
      'Les tests dans un catalogue, les métiers dans un autre abonnement, l’administratif dans un logiciel de gestion, les synthèses dans un traitement de texte. Gonabi tient les quatre.',
    shape: 'block-round',
    color: 'var(--blue)',
  },
  {
    titre: 'La conformité naît de l’accompagnement',
    texte:
      'Les autres outils qualité vous demandent de saisir vos preuves dans un module à part. Ici, la séance que vous menez les produit.',
    shape: 'arc-concave',
    color: 'var(--accent)',
  },
  {
    titre: 'Votre méthode reste la vôtre',
    texte:
      'Vos ressources, vos trames de parcours, vos supports. L’outil structure votre pratique, il ne la remplace pas par la sienne.',
    shape: 'half-disc',
    color: 'var(--yellow)',
  },
];

/**
 * Un segment = un onglet. Chaque panneau a sa propre photo — jamais la même
 * deux fois, ce qui laisserait croire à quatre profils clients identiques.
 */
const segmentVisuals: Record<string, { src: string; alt: string; shape: ShapeVariant; color: string }> = {
  '/solutions/cabinets-rh': {
    src: '/assets/photos/poignee-main-arc.jpg',
    alt: 'Poignée de main entre deux professionnels',
    shape: 'block-round',
    color: 'var(--blue)',
  },
  '/solutions/organismes-de-formation': {
    src: '/assets/photos/visio-groupe-casque.jpg',
    alt: 'Formatrice au casque en visioconférence de groupe',
    shape: 'arc-concave',
    color: 'var(--accent)',
  },
  '/solutions/coachs-independants': {
    src: '/assets/photos/bureau-maison-lampe.jpg',
    alt: 'Consultant indépendant travaillant depuis son bureau à domicile',
    shape: 'half-disc',
    color: 'var(--yellow)',
  },
  '/solutions/insertion-professionnelle': {
    src: '/assets/photos/laptop-cuisine-lumineuse.jpg',
    alt: 'Professionnelle de l’accompagnement travaillant sur son ordinateur portable',
    shape: 'block-round',
    color: 'var(--yellow)',
  },
};

/** Badges pleins, mêmes formes que Différenciation pour la cohérence. */
const confiance: { shape: ShapeVariant; color: string; titre: string; texte: string }[] = [
  {
    shape: 'half-disc',
    color: 'var(--yellow)',
    titre: 'Vos séances ne sont pas enregistrées',
    texte: 'Ni audio, ni vidéo. Seule la connexion à la plateforme est journalisée.',
  },
  {
    shape: 'arc-concave',
    color: 'var(--accent)',
    titre: 'Les dossiers sont cloisonnés',
    texte: 'L’accès est limité à l’organisation et au parcours suivi.',
  },
  {
    shape: 'block-round',
    color: 'var(--blue)',
    titre: 'Les preuves sont conservées 5 ans',
    texte: 'La durée pendant laquelle un dossier financé peut être contrôlé.',
  },
];
---

<BaseLayout
  title="Gonabi"
  description="Gonabi réunit tests psychométriques, parcours, exploration métiers, synthèses et preuves Qualiopi dans un seul outil, pour les cabinets RH et les organismes de formation."
  canonical="/"
>
  <!-- ══════════════ HERO ══════════════ -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__content">
        <p class="eyebrow hero__eyebrow">Plateforme d’accompagnement professionnel</p>

        <h1 class="hero__title">
          La plateforme qui structure, automatise et valorise vos accompagnements
          <span class="rotator">
            {
              rotations.map((r, i) => (
                <span class:list={['rotator__item', `is-${r.couleur}`]} style={`--step: ${i}`}>
                  {r.texte}
                </span>
              ))
            }
          </span>
        </h1>

        <p class="lead hero__lead">
          Créez des parcours sur mesure, automatisez les tâches répétitives et gérez vos suivis en
          temps réel, au même endroit.
        </p>

        <div class="hero__actions">
          <a href={DEMO_HREF} class="btn btn--primary">Réserver une démo</a>
          <a href="/produit" class="btn btn--secondary">Découvrir la solution</a>
        </div>

        <ul class="hero__badges">
          {
            reassurances.map((item) => (
              <li>
                <ShapeMask variant={item.shape} color={item.color} size={14} class="hero__badge-shape" />
                {item.texte}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="hero__visual">
        <div class="hero__stage">
          <!-- Bloc de couleur : même gabarit que la photo, décalé de 20px -->
          <div class="hero__color-block"></div>

          <div class="hero__photo-frame">
            <img
              src="/assets/photos/hero-laptop-cafe.jpg"
              alt="Consultante travaillant sur son ordinateur portable"
              loading="eager"
              fetchpriority="high"
            />
          </div>

          <!-- Bande verticale de couleurs de marque -->
          <div class="hero__stripe" aria-hidden="true">
            <span style="background: var(--accent)"></span>
            <span style="background: var(--blue)"></span>
            <span style="background: var(--yellow)"></span>
          </div>

          <!-- Tuiles à cheval sur le bord de la photo -->
          <div class="hero__tiles">
            {
              heroTiles.map((tile) => (
                <div class="hero-tile">
                  <Icon name={tile.icon} size={16} />
                  <span>{tile.label}</span>
                </div>
              ))
            }
          </div>

          <div class="hero-tile hero-tile--parcours">
            <p class="hero-tile__title">Nouveau parcours</p>
            <ol class="hero-tile__steps">
              <li><span class="hero-tile__step-num">1</span> Tests</li>
              <li><span class="hero-tile__step-num">2</span> Compétences</li>
              <li><span class="hero-tile__step-num is-muted">3</span> —</li>
              <li><span class="hero-tile__step-num">4</span> Bilan</li>
            </ol>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════ PARTENAIRES ══════════════ -->
  <section class="partners">
    <div class="container partners__inner">
      <p class="eyebrow partners__label">Ils nous font confiance</p>
      <ul class="partners__row">
        {
          partenaires.map((p) => (
            <li>
              <img src={p.src} alt={p.alt} loading="lazy" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ══════════════ FREINS — rangées à marqueur rond, pas de numéros ══════════════ -->
  <section class="section section--paper">
    <div class="container container--narrow">
      <header class="block-head" data-reveal>
        <p class="eyebrow eyebrow--rule">Le constat</p>
        <h2 class="block-head__title">Ce qui vous freine <em>aujourd’hui</em></h2>
      </header>

      <ul class="rows">
        {
          freins.map((frein, i) => (
            <li class="row" data-reveal>
              <ShapeMask
                variant={(['half-disc', 'arc-concave', 'block-round'] as const)[i % 3]}
                color={['var(--blue)', 'var(--accent)', 'var(--yellow)'][i % 3]}
                size={18}
                class="row__marker"
              />
              <div>
                <h3 class="row__title">{frein.titre}</h3>
                <p class="row__text">{frein.texte}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ══════════════ TÉMOIGNAGE — carte blanche arrondie sur fond crème ══════════════ -->
  <section class="section section--tight section--paper-light">
    <div class="container">
      <figure class="quote-card" data-reveal>
        <blockquote class="quote-card__text">
          Avant, je passais mes jeudis soirs à rédiger mes synthèses. Maintenant, je génère un
          rapport complet en trois clics pendant la séance. Mes jeudis soirs m’appartiennent à
          nouveau.
        </blockquote>
        <figcaption class="quote-card__source">
          <span class="quote-card__avatar" aria-hidden="true">C</span>
          Coach en reconversion · bêta-testeuse · six accompagnements en parallèle
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ══════════════ PRODUIT — fond clair, panneau illustratif + badge chiffré ══════════════ -->
  <section class="section section--paper-light">
    <div class="container produit__grid">
      <div class="produit__aside" data-reveal>
        <p class="eyebrow eyebrow--rule">Le produit</p>
        <h2 class="produit__title">Tout l’accompagnement dans <em>un seul</em> outil</h2>
        <p class="lead produit__lead">
          Chaque brique alimente la suivante : les tests nourrissent l’exploration métiers, le
          parcours produit ses preuves, et la synthèse se rédige à partir de tout ce qui précède.
        </p>

        <ul class="produit__tags">
          {
            produit?.children?.map((page) => (
              <li>
                <a href={page.href}>{page.label}</a>
              </li>
            ))
          }
        </ul>

        <a href="/produit" class="link-arrow produit__all">
          Voir la vue d’ensemble
          <Icon name="arrow-right" size={16} />
        </a>
      </div>

      <div class="produit__visual">
        <div class="produit__color-block"></div>

        <div class="produit-panel">
          <p class="produit-panel__title">Nouveau parcours</p>
          <div class="produit-panel__row">
            <span class="chip chip--blue">Tests</span>
            <span class="produit-panel__bar"><span style="width: 82%; background: var(--blue)" /></span>
          </div>
          <div class="produit-panel__row">
            <span class="chip chip--red">Compétences</span>
            <span class="produit-panel__bar"><span style="width: 54%; background: var(--accent)" /></span>
          </div>
          <div class="produit-panel__row">
            <span class="chip chip--yellow">Synthèse</span>
            <span class="produit-panel__bar"><span style="width: 20%; background: var(--yellow)" /></span>
          </div>
        </div>

        <div class="stat-badge">
          <span class="stat-badge__num">2-4H</span>
          <span class="stat-badge__label">gagnées par audit</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════ POUR QUI — onglets pilules, un panneau photo+texte ══════════════ -->
  <section class="section section--paper" id="pour-qui">
    <div class="container">
      <header class="block-head" data-reveal>
        <p class="eyebrow eyebrow--rule">Pour qui</p>
        <h2 class="block-head__title">
          Conçu d’abord pour les structures de <em>8 à 25 consultants</em>
        </h2>
      </header>

      <!--
        `<details name="segment-tabs">` : accordéon exclusif natif du
        navigateur (un seul ouvert à la fois), sans état CSS custom à
        maintenir. La version précédente (radios + sélecteurs `:checked`
        combinés à des attributs) se désynchronisait de façon incohérente à
        la vérification — `<details name>` élimine la classe de bug entière.
      -->
      <div class="tabs">
        {
          segments.map((page, i) => {
            const visual = segmentVisuals[page.href];
            return (
              <details class="tabs__item" name="segment-tabs" open={i === 0}>
                <summary class="tabs__summary">
                  <span>{page.label}</span>
                  <Icon name="arrow-right" size={18} class="tabs__chevron" />
                </summary>
                <div class="tabs__panel">
                  <div class="tabs__panel-text">
                    <p>{page.description}</p>
                    <a href={page.href} class="link-arrow">
                      En savoir plus
                      <Icon name="arrow-right" size={16} />
                    </a>
                  </div>
                  {visual && (
                    <div class="tabs__panel-visual">
                      <ShapeMask
                        variant={visual.shape}
                        color={visual.color}
                        size={200}
                        class="tabs__panel-backdrop"
                      />
                      <div class="tabs__panel-photo">
                        <img src={visual.src} alt={visual.alt} loading="lazy" />
                      </div>
                    </div>
                  )}
                </div>
              </details>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- ══════════════ DIFFÉRENCIATION — badges pleins ══════════════ -->
  <section class="section section--paper-light">
    <div class="container">
      <header class="block-head block-head--wide" data-reveal>
        <p class="eyebrow eyebrow--rule">La différence</p>
        <h2 class="block-head__title">Trois choix que nous <em>assumons</em></h2>
      </header>

      <div class="columns">
        {
          differences.map((item) => (
            <article class="column" data-reveal>
              <IconBadge shape={item.shape} color={item.color} />
              <h3 class="column__title">{item.titre}</h3>
              <p class="column__text">{item.texte}</p>
            </article>
          ))
        }
      </div>

      <p class="columns__after">
        <a href="/produit/syntheses-ia" class="link-arrow">
          Voir comment se génère une synthèse
          <Icon name="arrow-right" size={16} />
        </a>
      </p>
    </div>
  </section>

  <!-- ══════════════ MIGRATION — citation en exergue ══════════════ -->
  <section class="section section--paper migration">
    <div class="container migration__grid">
      <blockquote class="pull" data-reveal>
        <p class="pull__quote">« Encore une plateforme de plus à gérer ? »</p>
        <footer class="pull__source">
          La première objection que nous entendons, relevée en entretien de clôture bêta.
        </footer>
      </blockquote>

      <div class="migration__body" data-reveal>
        <p>
          Elle est juste : un outil qui s’ajoute aux autres sans en remplacer aucun fait perdre du
          temps au lieu d’en gagner.
        </p>
        <p>
          C’est pourquoi nous commençons toujours par regarder ce que Gonabi remplace chez vous —
          et ce qu’il ne remplacera pas.
        </p>
        <a href="/migrer-vers-gonabi" class="link-arrow">
          Migrer vers Gonabi
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════ CONFIANCE — badges pleins, rangées à filets ══════════════ -->
  <section class="section section--paper-light">
    <div class="container trust__grid">
      <div data-reveal>
        <p class="eyebrow eyebrow--rule">Confiance</p>
        <h2 class="trust__title">Des données sensibles, <em>traitées comme telles</em></h2>
        <p class="lead trust__lead">
          Un bilan de compétences produit des informations intimes, protégées par la loi. Nous
          documentons publiquement ce que nous en faisons — et ce que nous nous interdisons.
        </p>
        <a href="/a-propos/securite-rgpd" class="link-arrow">
          Sécurité &amp; RGPD
          <Icon name="arrow-right" size={16} />
        </a>
      </div>

      <ul class="trust__list">
        {
          confiance.map((item) => (
            <li class="trust__item" data-reveal>
              <IconBadge shape={item.shape} color={item.color} size={40} />
              <div>
                <h3 class="trust__item-title">{item.titre}</h3>
                <p class="trust__item-text">{item.texte}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ══════════════ CTA FINAL — carte pleine couleur, centrée ══════════════ -->
  <section class="section cta">
    <div class="container">
      <div class="cta-card">
        <h2 class="cta-card__title">Voir Gonabi tourner sur <em>vos propres cas</em></h2>
        <p class="cta-card__text">
          Une démonstration guidée, adaptée à votre structure et à vos accompagnements.
        </p>
        <a href={DEMO_HREF} class="btn btn--primary">Réserver une démo</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ════════════════════════ HERO ════════════════════════ */

  .hero {
    background: var(--paper);
    padding-block: clamp(48px, 7vw, 112px) clamp(56px, 8vw, 128px);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--space-16);
    align-items: center;
  }

  .hero__eyebrow {
    margin-bottom: var(--space-8);
  }

  .hero__title {
    max-width: 15ch;
    margin-bottom: var(--space-8);
  }

  /*
   * Empilement en grille plutôt qu'en position absolue : les trois phrases
   * n'ont pas la même longueur et certaines passent sur deux lignes selon la
   * largeur d'écran. Avec `position: absolute` sur les items, le conteneur ne
   * réservait la hauteur que d'une ligne — la phrase la plus longue débordait
   * alors sur le texte suivant (chapô). En grille, les trois textes occupent
   * la même cellule (`grid-area: 1/1`) et le conteneur se dimensionne
   * automatiquement sur le plus grand des trois, quel que soit le nombre de
   * lignes qu'il occupe.
   */
  .rotator {
    display: grid;
  }

  .rotator__item {
    grid-area: 1 / 1;
    align-self: start;
    opacity: 0;
    animation: rotator 10.5s infinite;
    animation-delay: calc(var(--step) * 3.5s);
  }

  .rotator__item.is-blue {
    color: var(--blue-deep);
  }
  .rotator__item.is-red {
    color: var(--accent);
  }
  .rotator__item.is-ochre {
    color: var(--ochre);
  }

  @keyframes rotator {
    0%,
    2% {
      opacity: 0;
    }
    5%,
    28% {
      opacity: 1;
    }
    33%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rotator__item {
      animation: none;
    }
    .rotator__item:first-child {
      opacity: 1;
    }
  }

  .hero__lead {
    max-width: 46ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .hero__badges {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-8);
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: var(--border-hairline) solid var(--rule);
  }

  .hero__badges li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    letter-spacing: 0.005em;
    color: var(--text-muted);
  }

  /* ── Visuel : bloc de couleur plein + photo + bande + tuiles à cheval ── */

  .hero__visual {
    position: relative;
    padding: 24px 24px 44px 8px;
  }

  /*
   * `.hero__stage` porte la vraie taille (aspect-ratio) ; le bloc de couleur
   * et le cadre photo sont tous deux `inset: 0` sur cette même boîte, donc
   * strictement du même gabarit — le bloc est juste décalé de 20px en x/y.
   * L'ancienne version dimensionnait le bloc en `%` de `.hero__visual` (qui
   * inclut son padding) pendant que la photo suivait le flux normal : les
   * deux gabarits divergeaient et le bloc débordait largement de la photo.
   */
  .hero__stage {
    position: relative;
    aspect-ratio: 4 / 3;
  }

  .hero__color-block {
    position: absolute;
    inset: 0;
    transform: translate(20px, 20px);
    background: var(--blue);
    border-radius: var(--radius-photo);
    z-index: 0;
  }

  .hero__photo-frame {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: var(--radius-photo);
    overflow: hidden;
    box-shadow: var(--shadow-tile-lg);
    /* Le texte alternatif d'une image non chargée ne doit pas s'afficher en
       gros caractères sombres dans le cadre : neutralisé le temps que les
       photos réelles arrivent, sans effet une fois l'image chargée. */
    background: var(--paper-light);
    color: transparent;
    font-size: 0;
  }

  .hero__photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }

