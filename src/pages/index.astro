  /* ============================================================
     BANDEAU DÉFILANT — partenaires
     ============================================================ */

  .partners {
    background: var(--paper-light);
    padding-block: clamp(32px, 5vw, 56px);
    border-top: var(--border-hairline) solid var(--rule);
    border-bottom: var(--border-hairline) solid var(--rule);
  }

  .marquee {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee__track {
    display: flex;
    align-items: center;
    gap: clamp(64px, 9vw, 128px);
    list-style: none;
    width: max-content;
    /* Trois copies : à -33,33% la boucle est invisible. */
    animation: marquee 42s linear infinite;
  }

  .marquee:hover .marquee__track,
  .marquee:focus-within .marquee__track {
    animation-play-state: paused;
  }

  @keyframes marquee {
    to {
      transform: translateX(-33.3333%);
    }
  }

  .partners .marquee__track img {
    height: 64px;
    width: auto;
    /* Fond blanc opaque des fichiers, effacé sur le crème par le blend mode. */
    mix-blend-mode: multiply;
    filter: grayscale(1);
    opacity: 0.55;
    transition: opacity var(--duration) var(--ease);
  }

  .partners .marquee__track img:hover {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
      width: auto;
      overflow-x: auto;
    }
