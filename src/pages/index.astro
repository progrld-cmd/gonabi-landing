---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { DEMO_HREF, mainNav } from '../data/navigation';
import type { IconName } from '../components/Icon.astro';

const produit = mainNav.find((group) => group.label === 'Produit');
const solutions = mainNav.find((group) => group.label === 'Solutions');
const segments = solutions?.children?.filter((page) => page.href.startsWith('/solutions/')) ?? [];

const partenaires = [
  { src: '/assets/partners/missions_locales_grayscale.png', alt: 'Missions Locales' },
  { src: '/assets/partners/aura_grayscale.png', alt: 'Région Auvergne-Rhône-Alpes' },
  { src: '/assets/partners/cma_grayscale.png', alt: 'Chambre de Métiers et de l’Artisanat' },
  { src: '/assets/partners/edlv_grayscale.png', alt: 'EDLV' },
  { src: '/assets/partners/french_tech_grayscale.png', alt: 'French Tech' },
];

const reassurances: { icone: IconName; texte: string }[] = [
  { icone: 'infinity', texte: 'IA illimitée, sans compteur' },
  { icone: 'shield-check', texte: 'Preuves Qualiopi automatiques' },
  { icone: 'eye-off', texte: 'Aucun enregistrement de séance' },
];

const freins = [
  {
    titre: 'Vos outils ne se parlent pas',
    texte:
      'Un outil pour les tests, un tableur pour le suivi, une boîte mail pour les documents, un traitement de texte pour les synthèses. Chaque passage de l’un à l’autre se paie en ressaisie.',
  },
  {
    titre: 'L’administratif mange le temps d’accompagnement',
    texte:
      'Le temps passé à remettre en forme, retrouver, recopier est du temps qui ne va ni au bénéficiaire ni à de nouveaux dossiers.',
  },
  {
    titre: 'Les preuves se reconstituent après coup',
    texte:
      'À l’approche de l’audit, il faut retrouver qui a signé quoi, quand, et sur quelle séance. Nos bêta-testeurs estimaient y passer 2 à 4 heures par audit — un travail refait à chaque cycle.',
  },
];

const differences = [
  {
    titre: 'L’IA n’est pas rationnée',
    texte:
      'Générer une synthèse ne consomme aucun crédit. Notre prix ne dépend pas du nombre de synthèses que vous produisez — c’est un choix de modèle économique, pas une promotion.',
  },
  {
    titre: 'La conformité naît de l’accompagnement',
    texte:
      'Les preuves Qualiopi ne se saisissent pas dans un module à part : elles sont produites par les séances que vous menez déjà.',
  },
  {
    titre: 'Le bénéficiaire est dans la boucle',
    texte:
      'Il passe ses tests, suit son parcours et explore ses pistes depuis son propre espace. Vous décidez de ce qu’il voit, et quand.',
  },
];

const confiance: { icone: IconName; titre: string; texte: string }[] = [
  {
    icone: 'eye-off',
    titre: 'Vos séances ne sont pas enregistrées',
    texte: 'Ni audio, ni vidéo. Seule la connexion à la plateforme est journalisée.',
  },
  {
    icone: 'lock',
    titre: 'Les dossiers sont cloisonnés',
    texte: 'L’accès est limité à l’organisation et au parcours suivi.',
  },
  {
    icone: 'file-text',
    titre: 'Les preuves sont conservées 5 ans',
    texte: 'La durée pendant laquelle un dossier financé peut être contrôlé.',
  },
];
---

<BaseLayout
  title="Gonabi"
  description="Gonabi réunit tests psychométriques, parcours, exploration métiers et synthèses IA dans un seul outil pour les cabinets RH et organismes de formation. L'IA est illimitée."
  canonical="/"
>
  <!-- ══════════════ HERO — asymétrique, aligné à gauche ══════════════ -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__content">
        <p class="eyebrow hero__eyebrow">Plateforme d’accompagnement professionnel</p>

        <h1 class="hero__title">
          Structurez, automatisez et <span class="mark">valorisez</span> vos accompagnements
        </h1>

        <p class="lead hero__lead">
          Tests, parcours, exploration métiers, synthèses et preuves de conformité au même endroit.
          Vous passez moins de temps à administrer, plus de temps à accompagner.
        </p>

        <div class="hero__actions">
          <a href={DEMO_HREF} class="btn btn--primary">Réserver une démo</a>
          <a href="/produit" class="btn btn--secondary">Découvrir le produit</a>
        </div>

        <ul class="hero__badges">
          {
            reassurances.map((item) => (
              <li>
                <Icon name={item.icone} size={17} />
                {item.texte}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="hero__visual">
        <img
          src="/assets/images/Hero_visual.png"
          alt="Interface Gonabi : tableau de bord, profil psychométrique et parcours personnalisés"
          width="760"
          height="570"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- ══════════════ PARTENAIRES — bandeau fin cerné de filets ══════════════ -->
  <section class="partners">
    <div class="container partners__inner">
      <p class="eyebrow partners__label">Ils nous font confiance</p>
      <ul class="partners__row">
        {
          partenaires.map((p) => (
            <li>
              <img src={p.src} alt={p.alt} loading="lazy" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ══════════════ FREINS — rangées numérotées, pas de cartes ══════════════ -->
  <section class="section section--paper">
    <div class="container">
      <header class="block-head" data-reveal>
        <p class="eyebrow eyebrow--rule">Le constat</p>
        <h2 class="block-head__title">Ce qui vous freine aujourd’hui</h2>
      </header>

      <ol class="figures">
        {
          freins.map((frein, i) => (
            <li class="figure" data-reveal>
              <span class="numeral figure__num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="figure__title">{frein.titre}</h3>
              <p class="figure__text">{frein.texte}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ══════════════ PRODUIT — pleine page encre, index éditorial ══════════════ -->
  <section class="section section--ink produit">
    <div class="container produit__grid">
      <div class="produit__aside">
        <p class="eyebrow eyebrow--rule">Le produit</p>
        <h2 class="produit__title">Tout l’accompagnement dans un seul outil</h2>
        <p class="lead produit__lead">
          Chaque brique alimente la suivante : les tests nourrissent l’exploration métiers, le
          parcours produit ses preuves, et la synthèse se rédige à partir de tout ce qui précède.
        </p>
        <a href="/produit" class="link-arrow produit__all">
          Voir la vue d’ensemble
          <Icon name="arrow-right" size={16} />
        </a>
      </div>

      <ul class="index-list">
        {
          produit?.children?.map((page) => (
            <li>
              <a href={page.href} class="index-row">
                <span class="index-row__label">{page.label}</span>
                <span class="index-row__desc">{page.description}</span>
                <Icon name="arrow-up-right" size={18} class="index-row__icon" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ══════════════ SEGMENTS — titre à gauche, grille 2×2 à droite ══════════════ -->
  <section class="section section--paper">
    <div class="container segments__grid">
      <div class="segments__aside" data-reveal>
        <p class="eyebrow eyebrow--rule">Pour qui</p>
        <h2 class="segments__title">Conçu d’abord pour les structures de 8 à 25&nbsp;consultants</h2>
        <p class="segments__note">
          Cabinets RH et organismes de formation qui accompagnent en bilan de compétences,
          évolution professionnelle ou orientation.
        </p>
      </div>

      <div class="segments__list">
        {
          segments.map((page) => (
            <a href={page.href} class="segment" data-reveal>
              <h3 class="segment__title">{page.label}</h3>
              <p class="segment__text">{page.description}</p>
              <span class="segment__more" aria-hidden="true">
                <Icon name="arrow-right" size={16} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ══════════════ DIFFÉRENCIATION — trois colonnes séparées de filets ══════════════ -->
  <section class="section section--paper-light">
    <div class="container">
      <header class="block-head block-head--wide" data-reveal>
        <p class="eyebrow eyebrow--rule">La différence</p>
        <h2 class="block-head__title">Trois choix que nous assumons</h2>
      </header>

      <div class="columns">
        {
          differences.map((item, i) => (
            <article class="column" data-reveal>
              <span class="numeral column__num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="column__title">{item.titre}</h3>
              <p class="column__text">{item.texte}</p>
            </article>
          ))
        }
      </div>

      <p class="columns__after">
        <a href="/produit/syntheses-ia" class="link-arrow">
          Comprendre l’IA illimitée
          <Icon name="arrow-right" size={16} />
        </a>
      </p>
    </div>
  </section>

  <!-- ══════════════ MIGRATION — citation en exergue ══════════════ -->
  <section class="section section--paper migration">
    <div class="container migration__grid">
      <blockquote class="pull" data-reveal>
        <p class="pull__quote">
          « Je vais perdre mon historique, et mes consultants vont devoir tout réapprendre. »
        </p>
        <footer class="pull__source">L’objection que nous entendons le plus, avant le prix.</footer>
      </blockquote>

      <div class="migration__body" data-reveal>
        <p>
          La friction du changement d’outil passe devant le tarif et devant les fonctionnalités
          dans les échanges que nous avons avec les cabinets et les organismes de formation.
        </p>
        <p>
          Nous lui avons consacré une page entière plutôt qu’un paragraphe rassurant en bas d’un
          argumentaire.
        </p>
        <a href="/migrer-vers-gonabi" class="link-arrow">
          Migrer vers Gonabi
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════ CONFIANCE — texte à gauche, liste à droite ══════════════ -->
  <section class="section section--paper-light">
    <div class="container trust__grid">
      <div data-reveal>
        <p class="eyebrow eyebrow--rule">Confiance</p>
        <h2 class="trust__title">Des données sensibles, traitées comme telles</h2>
        <p class="lead trust__lead">
          Un bilan de compétences produit des informations intimes, protégées par la loi. Nous
          documentons publiquement ce que nous en faisons — et ce que nous nous interdisons.
        </p>
        <a href="/a-propos/securite-rgpd" class="link-arrow">
          Sécurité &amp; RGPD
          <Icon name="arrow-right" size={16} />
        </a>
      </div>

      <ul class="trust__list">
        {
          confiance.map((item) => (
            <li class="trust__item" data-reveal>
              <Icon name={item.icone} size={22} class="trust__icon" />
              <div>
                <h3 class="trust__item-title">{item.titre}</h3>
                <p class="trust__item-text">{item.texte}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ══════════════ CTA FINAL — bandeau encre, composition large ══════════════ -->
  <section class="section section--ink cta">
    <div class="container cta__grid">
      <h2 class="cta__title">Voir Gonabi tourner sur vos propres cas</h2>
      <div class="cta__side">
        <p class="cta__text">
          Une démonstration guidée, adaptée à votre structure et à vos accompagnements.
        </p>
        <a href={DEMO_HREF} class="btn btn--primary">Réserver une démo</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ════════════════════════ HERO ════════════════════════ */

  .hero {
    background: var(--paper);
    padding-block: clamp(48px, 7vw, 112px) clamp(56px, 8vw, 128px);
    overflow: hidden;
  }

  .hero__grid {
    display: grid;
    /* La colonne texte est la plus large : un H1 à 68px a besoin de place, sinon
       il part sur huit lignes. Le visuel compense en débordant hors du conteneur
       jusqu'au bord de l'écran. */
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--space-16);
    align-items: center;
  }

  .hero__eyebrow {
    margin-bottom: var(--space-8);
  }

  .hero__title {
    max-width: 15ch;
    margin-bottom: var(--space-8);
  }

  .hero__lead {
    max-width: 46ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .hero__badges {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-8);
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: var(--border-hairline) solid var(--rule);
  }

  .hero__badges li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    letter-spacing: 0.005em;
    color: var(--text-muted);
  }

  .hero__badges :global(svg) {
    color: var(--accent);
    flex-shrink: 0;
  }

  /*
   * Le visuel sort du conteneur et va jusqu'au bord droit de l'écran : c'est la
   * grille brisée qui donne son caractère au hero. Sous 1200px le calcul retombe
   * naturellement sur un simple débord de gouttière. `overflow: hidden` sur
   * `.hero` empêche tout défilement horizontal.
   */
  .hero__visual {
    position: relative;
    margin-right: calc((100vw - min(100vw, var(--container))) / -2 - var(--gutter));
  }

  .hero__visual img {
    width: 100%;
    border-radius: var(--radius-lg);
  }

  /* Apparition au chargement, échelonnée */
  @media (prefers-reduced-motion: no-preference) {
    .hero__eyebrow,
    .hero__title,
    .hero__lead,
    .hero__actions,
    .hero__badges,
    .hero__visual {
      animation: rise 620ms var(--ease) backwards;
    }
    .hero__eyebrow {
      animation-delay: 40ms;
    }
    .hero__title {
      animation-delay: 100ms;
    }
    .hero__lead {
      animation-delay: 180ms;
    }
    .hero__actions {
      animation-delay: 250ms;
    }
    .hero__badges {
      animation-delay: 310ms;
    }
    .hero__visual {
      animation-delay: 160ms;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ════════════════════════ PARTENAIRES ════════════════════════ */

  .partners {
    background: var(--paper-light);
    border-block: var(--border-hairline) solid var(--rule);
  }

  .partners__inner {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    padding-block: var(--space-8);
  }

  .partners__label {
    flex-shrink: 0;
    color: var(--ink-40);
  }

  .partners__row {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: 1;
    gap: var(--space-8);
  }

  .partners__row img {
    height: 26px;
    width: auto;
    opacity: 0.5;
    filter: grayscale(1);
    transition: opacity var(--duration) var(--ease);
  }

  .partners__row img:hover {
    opacity: 0.85;
  }

  /* ════════════════════════ EN-TÊTES DE BLOC ════════════════════════ */

  .block-head {
    max-width: 720px;
    margin-bottom: var(--space-24);
  }

  .block-head--wide {
    max-width: 900px;
  }

  .block-head__title {
    margin-top: var(--space-8);
  }

  /* ════════════════════════ FREINS ════════════════════════ */

  .figures {
    list-style: none;
  }

  .figure {
    display: grid;
    grid-template-columns: 110px minmax(0, 4fr) minmax(0, 6fr);
    gap: var(--space-8);
    align-items: start;
    padding-block: var(--space-16);
    border-top: var(--border-hairline) solid var(--rule);
  }

  .figure:last-child {
    border-bottom: var(--border-hairline) solid var(--rule);
  }

  .figure__num {
    /* Aligne l'œil du chiffre sur la ligne de base du titre */
    margin-top: -0.12em;
  }

  .figure__title {
    font-size: var(--size-h3);
  }

  .figure__text {
    color: var(--text-muted);
    max-width: 56ch;
  }

  /* ════════════════════════ PRODUIT (encre) ════════════════════════ */

  .produit__grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: var(--space-16);
    align-items: start;
  }

  .produit__aside {
    position: sticky;
    top: 120px;
  }

  .produit__title {
    margin-top: var(--space-8);
    margin-bottom: var(--space-8);
    max-width: 14ch;
  }

  .produit__lead {
    max-width: 42ch;
  }

  .produit__all {
    margin-top: var(--space-8);
  }

  .index-list {
    list-style: none;
    border-top: var(--border-hairline) solid var(--on-ink-rule);
  }

  .index-row {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr) 24px;
    gap: var(--space-8);
    align-items: baseline;
    padding: var(--space-8) var(--space-4) var(--space-8) 0;
    border-bottom: var(--border-hairline) solid var(--on-ink-rule);
    text-decoration: none;
    transition:
      padding-left var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  .index-row:hover {
    padding-left: var(--space-4);
    border-bottom-color: var(--on-ink-rule-strong);
  }

  .index-row__label {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-snug);
    color: var(--on-ink);
  }

  .index-row__desc {
    font-size: var(--size-small);
    line-height: 1.5;
    color: var(--on-ink-muted);
  }

  .index-row :global(.index-row__icon) {
    color: var(--on-ink-muted);
    transition:
      transform var(--duration) var(--ease),
      color var(--duration) var(--ease);
    align-self: center;
  }

  .index-row:hover :global(.index-row__icon) {
    transform: translate(3px, -3px);
    color: var(--accent);
  }

  /* ════════════════════════ SEGMENTS ════════════════════════ */

  .segments__grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: var(--space-16);
    align-items: start;
  }

  .segments__title {
    margin-top: var(--space-8);
    font-size: var(--size-h3);
  }

  .segments__note {
    margin-top: var(--space-4);
    font-size: var(--size-small);
    color: var(--text-muted);
    max-width: 40ch;
  }

  .segments__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-8) var(--space-16);
  }

  .segment {
    display: block;
    padding-top: var(--space-8);
    border-top: var(--border-hairline) solid var(--rule);
    text-decoration: none;
    transition: border-color var(--duration) var(--ease);
  }

  .segment:hover {
    border-top-color: var(--accent);
  }

  .segment__title {
    font-size: var(--size-h4);
    margin-bottom: var(--space-4);
  }

  .segment__text {
    font-size: var(--size-small);
    color: var(--text-muted);
    margin-bottom: var(--space-4);
  }

  .segment__more {
    display: inline-flex;
    color: var(--ink-40);
    transition:
      transform var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }

  .segment:hover .segment__more {
    transform: translateX(4px);
    color: var(--accent);
  }

  /* ════════════════════════ DIFFÉRENCIATION ════════════════════════ */

  .columns {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-16);
  }

  .column {
    padding-left: var(--space-8);
    border-left: var(--border-hairline) solid var(--rule);
  }

  .column:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .column__num {
    display: block;
    font-size: 2rem;
    color: var(--accent);
    margin-bottom: var(--space-8);
  }

  .column__title {
    font-size: var(--size-h4);
    margin-bottom: var(--space-4);
  }

  .column__text {
    font-size: var(--size-small);
    color: var(--text-muted);
  }

  .columns__after {
    margin-top: var(--space-16);
  }

  /* ════════════════════════ MIGRATION ════════════════════════ */

  .migration__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-16);
    align-items: center;
  }

  .pull {
    border-left: 2px solid var(--accent);
    padding-left: var(--space-8);
  }

  .pull__quote {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.2vw, 2.75rem);
    font-weight: var(--weight-medium);
    font-style: italic;
    line-height: 1.2;
    letter-spacing: var(--tracking-title);
    color: var(--text);
  }

  .pull__source {
    margin-top: var(--space-8);
    font-size: var(--size-small);
    color: var(--text-muted);
  }

  .migration__body p {
    color: var(--text-muted);
  }

  .migration__body p + p {
    margin-top: var(--space-4);
  }

  .migration__body .link-arrow {
    margin-top: var(--space-8);
  }

  /* ════════════════════════ CONFIANCE ════════════════════════ */

  .trust__grid {
    display: grid;
