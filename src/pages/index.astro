<script>
  /*
   * Onglets rotatifs — partagés par les sections « Produit » et « Pour qui ».
   * Chaque conteneur `[data-autotabs]` pointe vers un groupe de boutons
   * `role=tab` et de panneaux `role=tabpanel` qui le suivent dans le DOM
   * (jusqu'au prochain `[data-autotabs]` ou la fin de la section).
   * Rotation automatique par défaut, arrêtée dès qu'on interagit : reprendre
   * la main sur un carrousel ne doit jamais être annulé par la rotation.
   */
  const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-autotabs]').forEach((nav) => {
    const section = nav.closest('section');
    if (!section) return;

    const onglets = Array.from(nav.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panneaux = onglets.map((o) =>
      section.querySelector<HTMLElement>(`#${o.getAttribute('aria-controls')}`)
    );
    if (!onglets.length) return;

    let actif = 0;
    let minuteur: number | undefined;

    const afficher = (index: number) => {
      actif = index;
      onglets.forEach((onglet, i) => {
        const choisi = i === index;
        onglet.setAttribute('aria-selected', String(choisi));
        onglet.tabIndex = choisi ? 0 : -1;
        if (panneaux[i]) panneaux[i]!.hidden = !choisi;
      });
    };

    const arreter = () => {
      if (minuteur !== undefined) window.clearInterval(minuteur);
      minuteur = undefined;
    };

    const suivant = (pas: number) => {
      arreter();
      afficher((actif + pas + onglets.length) % onglets.length);
    };

    onglets.forEach((onglet, i) => {
      onglet.addEventListener('click', () => suivant(i - actif));
      onglet.addEventListener('keydown', (evenement) => {
        if (evenement.key !== 'ArrowRight' && evenement.key !== 'ArrowLeft') return;
        evenement.preventDefault();
        suivant(evenement.key === 'ArrowRight' ? 1 : -1);
        onglets[actif].focus();
      });
    });

    section.querySelectorAll<HTMLButtonElement>('[data-tab-prev]').forEach((b) =>
      b.addEventListener('click', () => suivant(-1))
    );
    section.querySelectorAll<HTMLButtonElement>('[data-tab-next]').forEach((b) =>
      b.addEventListener('click', () => suivant(1))
    );

    if (!reduit) {
      minuteur = window.setInterval(() => afficher((actif + 1) % onglets.length), 6000);
    }
  });

  /*
   * Carrousel de témoignages. Structure distincte des onglets : une seule
   * diapositive visible, navigation par flèches + puces, rotation automatique
   * par défaut.
   */
  const scene = document.querySelector<HTMLElement>('.voices');
  if (scene) {
    const slides = Array.from(scene.querySelectorAll<HTMLElement>('[data-voice-slide]'));
    const dots = Array.from(scene.querySelectorAll<HTMLButtonElement>('[data-voice-dot]'));
    let actif = 0;
    let minuteur: number | undefined;

    const afficher = (index: number) => {
      actif = (index + slides.length) % slides.length;
      slides.forEach((s, i) => (s.hidden = i !== actif));
      dots.forEach((d, i) => d.setAttribute('aria-selected', String(i === actif)));
    };

    const arreter = () => {
      if (minuteur !== undefined) window.clearInterval(minuteur);
      minuteur = undefined;
    };

    scene.querySelector('[data-voice-prev]')?.addEventListener('click', () => {
      arreter();
      afficher(actif - 1);
    });
    scene.querySelector('[data-voice-next]')?.addEventListener('click', () => {
      arreter();
      afficher(actif + 1);
    });
    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        arreter();
        afficher(i);
      })
    );

    if (!reduit) {
      minuteur = window.setInterval(() => afficher(actif + 1), 7000);
    }
  }
</script>
