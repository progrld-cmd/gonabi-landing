---
/**
 * Badge plein carré à coin arrondi, une des 3 formes du logo en blanc à
 * l'intérieur — remplace les icônes traits fins génériques (shield-check,
 * lock...) par un langage graphique propre à Gonabi. Repéré chez Culture Amp :
 * squircle coloré, glyphe blanc, jamais un trait fin sur fond transparent.
 */
import ShapeMask from './ShapeMask.astro';
import type { ShapeVariant } from './ShapeMask.astro';

export interface Props {
  shape: ShapeVariant;
  color: string;
  size?: number;
}

const { shape, color, size = 44 } = Astro.props;
---

<span class="icon-badge" style={`--badge-bg: ${color}; --badge-size: ${size}px`}>
  <ShapeMask variant={shape} color="#fff" size={size * 0.46} />
</span>

<style>
  .icon-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--badge-size);
    height: var(--badge-size);
    border-radius: 28%;
    background: var(--badge-bg);
    flex-shrink: 0;
  }
</style>
