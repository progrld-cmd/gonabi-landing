---
import { mainNav, DEMO_HREF } from '../data/navigation';

const { pathname } = Astro.url;

/** Une entrée est active si on est sur sa page ou sur une de ses sous-pages. */
function isActive(href?: string) {
  if (!href || href.startsWith('#')) return false;
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header class="site-header">
  <nav class="site-nav" aria-label="Navigation principale">
    <a href="/" class="site-nav__logo" aria-label="Gonabi — Accueil">
      <img src="/assets/logos/Gonabi_Logo_Horizontal.png" alt="Gonabi" width="150" height="40" />
    </a>

    <ul class="site-nav__list">
      {
        mainNav.map((group) => (
          <li class:list={['site-nav__item', { 'has-menu': !!group.children }]}>
            <a
              href={group.href}
              class="site-nav__link"
              aria-current={isActive(group.href) ? 'page' : undefined}
              aria-haspopup={group.children ? 'true' : undefined}
            >
              {group.label}
              {group.children && (
                <svg
                  class="site-nav__chevron"
                  width="10"
                  height="10"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              )}
            </a>

            {group.children && (
              <div class="site-nav__dropdown">
                <ul class="site-nav__dropdown-list">
                  {group.children.map((child) => (
                    <>
                      {child.group && (
                        <li class="site-nav__dropdown-heading" role="presentation">
                          {child.group}
                        </li>
                      )}
                      <li>
                        <a
                          href={child.href}
                          class="site-nav__dropdown-link"
                          aria-current={isActive(child.href) ? 'page' : undefined}
                        >
                          <span class="site-nav__dropdown-label">{child.label}</span>
                          {child.description && (
                            <span class="site-nav__dropdown-desc">{child.description}</span>
                          )}
                        </a>
                      </li>
                    </>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))
      }
    </ul>

    <a href={DEMO_HREF} class="btn btn--primary site-nav__cta">Réserver une démo</a>

    <button
      type="button"
      class="site-nav__burger"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
  </nav>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <ul class="mobile-menu__list">
      {
        mainNav.map((group) =>
          group.children ? (
            <li>
              <details class="mobile-menu__group" open={isActive(group.href)}>
                <summary class="mobile-menu__summary">
                  {group.label}
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </summary>
                <ul class="mobile-menu__sublist">
                  {group.href && (
                    <li>
                      <a href={group.href} class="mobile-menu__sublink">
                        Vue d’ensemble
                      </a>
                    </li>
                  )}
                  {group.children.map((child) => (
                    <>
                      {child.group && (
                        <li class="mobile-menu__subheading" role="presentation">
                          {child.group}
                        </li>
                      )}
                      <li>
                        <a
                          href={child.href}
                          class="mobile-menu__sublink"
                          aria-current={isActive(child.href) ? 'page' : undefined}
                        >
                          {child.label}
                        </a>
                      </li>
                    </>
                  ))}
                </ul>
              </details>
            </li>
          ) : (
            <li>
              <a
                href={group.href}
                class="mobile-menu__link"
                aria-current={isActive(group.href) ? 'page' : undefined}
              >
                {group.label}
              </a>
            </li>
          )
        )
      }
    </ul>

    <a href={DEMO_HREF} class="btn btn--primary mobile-menu__cta">Réserver une démo</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--paper);
    border-bottom: var(--border-hairline) solid var(--rule);
  }

  .site-nav {
    max-width: var(--container);
    margin-inline: auto;
    padding: var(--space-4) var(--gutter);
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .site-nav__logo {
    flex-shrink: 0;
  }

  .site-nav__logo img {
    height: 64px;
    width: auto;
  }

  @media (max-width: 1100px) {
    .site-nav__logo img {
      height: 52px;
    }
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    list-style: none;
    margin-left: auto;
  }

  .site-nav__item {
    position: relative;
  }

  .site-nav__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: var(--space-2) 12px;
    font-size: var(--size-small);
    font-weight: var(--weight-medium);
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    border-radius: var(--radius);
    transition: color var(--duration) var(--ease);
  }

  .site-nav__link:hover,
  .site-nav__item:focus-within > .site-nav__link {
    color: var(--accent-deep);
  }

  .site-nav__link[aria-current='page'] {
    color: var(--accent-deep);
  }

  .site-nav__chevron {
    opacity: 0.5;
    transition: transform var(--duration) var(--ease);
  }

  .site-nav__item:hover .site-nav__chevron,
  .site-nav__item:focus-within .site-nav__chevron {
    transform: rotate(180deg);
  }

  /* ---------- Sous-menu : panneau papier cerné d'un filet, sans ombre ---------- */

  .site-nav__dropdown {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    translate: -50% 0;
    min-width: 330px;
    background: var(--paper-light);
    border: var(--border-hairline) solid var(--rule-strong);
    border-radius: var(--radius-lg);
    padding: var(--space-2);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition:
      opacity var(--duration) var(--ease),
      transform var(--duration) var(--ease),
      visibility 0s linear var(--duration);
  }

  /* Pont invisible : le survol ne se coupe pas entre le lien et le panneau */
  .site-nav__dropdown::before {
    content: '';
    position: absolute;
    inset: -10px 0 100% 0;
  }

  .site-nav__item:hover .site-nav__dropdown,
  .site-nav__item:focus-within .site-nav__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition:
      opacity var(--duration) var(--ease),
      transform var(--duration) var(--ease),
      visibility 0s;
  }

  .site-nav__dropdown-list {
    list-style: none;
  }

  .site-nav__dropdown-heading {
    font-size: 11px;
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--ink-40);
    padding: var(--space-4) 12px var(--space-2);
  }

  .site-nav__dropdown-list > .site-nav__dropdown-heading:not(:first-child) {
    border-top: var(--border-hairline) solid var(--rule);
    margin-top: var(--space-2);
  }

  .site-nav__dropdown-link {
    display: block;
    padding: 10px 12px;
    border-radius: var(--radius);
    text-decoration: none;
    transition: background-color var(--duration) var(--ease);
  }

  .site-nav__dropdown-link:hover {
    background: var(--ink-08);
  }

  .site-nav__dropdown-link[aria-current='page'] .site-nav__dropdown-label {
    color: var(--accent-deep);
  }

  .site-nav__dropdown-label {
    display: block;
    font-size: var(--size-small);
    font-weight: var(--weight-semibold);
    color: var(--text);
  }

  .site-nav__dropdown-desc {
    display: block;
    font-size: 13px;
    line-height: 1.45;
    color: var(--text-muted);
    margin-top: 2px;
  }

  .site-nav__cta {
    flex-shrink: 0;
    padding: 12px 20px;
  }

  /* ---------- Burger : deux traits seulement ---------- */

  .site-nav__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 40px;
    height: 40px;
    margin-left: auto;
    padding: 10px 8px;
    background: transparent;
    border: var(--border-hairline) solid var(--rule-strong);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .site-nav__burger span {
    display: block;
    height: 1.5px;
    width: 100%;
    background: var(--ink);
    transition: transform var(--duration) var(--ease);
  }

  .site-nav__burger[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(3.75px) rotate(45deg);
  }

  .site-nav__burger[aria-expanded='true'] span:nth-child(2) {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  /* ---------- Menu mobile ---------- */

  .mobile-menu {
    display: none;
    padding: var(--space-4) var(--gutter) var(--space-16);
    background: var(--paper);
    border-top: var(--border-hairline) solid var(--rule);
    max-height: calc(100vh - 70px);
    overflow-y: auto;
  }

  .mobile-menu__list {
    list-style: none;
  }

  .mobile-menu__link,
  .mobile-menu__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-snug);
    color: var(--text);
    text-decoration: none;
    border-bottom: var(--border-hairline) solid var(--rule);
    cursor: pointer;
    list-style: none;
  }

  .mobile-menu__summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu__group[open] .mobile-menu__summary svg {
    transform: rotate(180deg);
  }

  .mobile-menu__summary svg {
    transition: transform var(--duration) var(--ease);
    flex-shrink: 0;
    opacity: 0.5;
  }

  .mobile-menu__sublist {
    list-style: none;
    padding: var(--space-4) 0 var(--space-8) var(--space-4);
  }

  .mobile-menu__subheading {
    font-size: 11px;
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--ink-40);
    padding: var(--space-4) 0 var(--space-2);
  }

  .mobile-menu__sublink {
    display: block;
    padding: 10px 0;
    font-size: var(--size-small);
    color: var(--text-muted);
    text-decoration: none;
  }

  .mobile-menu__sublink[aria-current='page'] {
    color: var(--accent-deep);
    font-weight: var(--weight-semibold);
  }

  .mobile-menu__cta {
    width: 100%;
    margin-top: var(--space-8);
  }

  /* ---------- Bascule ---------- */

  @media (max-width: 1100px) {
    .site-nav__list,
    .site-nav__cta {
      display: none;
    }

    .site-nav__burger {
      display: flex;
    }

    /* `:not([hidden])` est nécessaire : une règle de classe l'emporterait sur
       le `display: none` que le navigateur applique à l'attribut `hidden`. */
    .mobile-menu:not([hidden]) {
      display: block;
    }
  }
</style>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.site-nav__burger');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');

  if (burger && menu) {
    const setOpen = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
      menu.hidden = !open;
      document.body.style.overflow = open ? 'hidden' : '';
    };

    burger.addEventListener('click', () => {
      setOpen(burger.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        burger.focus();
      }
    });

    // Repasser en état fermé si l'écran redevient large, sinon le body reste bloqué.
    window.matchMedia('(min-width: 1101px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
