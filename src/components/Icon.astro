---
/**
 * Jeu d'icônes du site. Tracé uniquement, stroke-width 1.5 partout,
 * viewBox 24 — cohérence absolue du trait. Aucun emoji nulle part.
 */
export type IconName =
  | 'arrow-right'
  | 'arrow-up-right'
  | 'infinity'
  | 'shield-check'
  | 'eye-off'
  | 'layers'
  | 'compass'
  | 'file-text'
  | 'users'
  | 'lock'
  | 'check'
  | 'zap'
  | 'arrow-left';

export interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;

const paths: Record<IconName, string> = {
  'arrow-right': '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
  'arrow-up-right': '<path d="M7 17 17 7"/><path d="M8 7h9v9"/>',
  infinity:
    '<path d="M6.5 8.5a3.5 3.5 0 1 0 0 7c1.9 0 3.2-1.5 5.5-3.5s3.6-3.5 5.5-3.5a3.5 3.5 0 1 1 0 7c-1.9 0-3.2-1.5-5.5-3.5S8.4 8.5 6.5 8.5Z"/>',
  'shield-check': '<path d="M12 3 5 6v5.5c0 4 2.9 7.7 7 8.5 4.1-.8 7-4.5 7-8.5V6l-7-3Z"/><path d="m9.5 12 1.8 1.8 3.4-3.6"/>',
  'eye-off':
    '<path d="M10.7 6.2A9.6 9.6 0 0 1 12 6c5 0 9 6 9 6a15 15 0 0 1-2.4 2.9M6.5 8.3A15.4 15.4 0 0 0 3 12s4 6 9 6a9 9 0 0 0 3.6-.8"/><path d="m10.4 10.4a2.2 2.2 0 0 0 3.1 3.1"/><path d="M4 4l16 16"/>',
  layers: '<path d="m12 3 8 4.5-8 4.5-8-4.5L12 3Z"/><path d="m4 12.5 8 4.5 8-4.5"/><path d="m4 16.5 8 4.5 8-4.5"/>',
  compass: '<circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5-5 2 2-5 5-2Z"/>',
  'file-text':
    '<path d="M14 3H7a1.5 1.5 0 0 0-1.5 1.5v15A1.5 1.5 0 0 0 7 21h10a1.5 1.5 0 0 0 1.5-1.5V7.5L14 3Z"/><path d="M14 3v4.5h4.5"/><path d="M9 13h6"/><path d="M9 16.5h4"/>',
  users:
    '<path d="M15.5 20v-1.5a3.5 3.5 0 0 0-3.5-3.5H7a3.5 3.5 0 0 0-3.5 3.5V20"/><circle cx="9.5" cy="8" r="3.2"/><path d="M20.5 20v-1.5a3.5 3.5 0 0 0-2.6-3.4"/><path d="M15.5 4.6a3.2 3.2 0 0 1 0 6.2"/>',
  lock: '<rect x="4.5" y="10.5" width="15" height="9.5" rx="1.5"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7"/>',
  zap: '<path d="M12.5 2.5 5 14h5.5L11 21.5 19 10h-5.5L12.5 2.5Z"/>',
  'arrow-left': '<path d="M19 12H5"/><path d="m11 18-6-6 6-6"/>',
};
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
