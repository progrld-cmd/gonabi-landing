---
import { footerNav, legalNav, DEMO_HREF } from '../data/navigation';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <a href="/" aria-label="Gonabi — Accueil">
        <img
          src="/assets/logos/Gonabi_Logo_Horizontal.png"
          alt="Gonabi"
          width="160"
          height="44"
          loading="lazy"
        />
      </a>
      <p class="site-footer__tagline">
        La plateforme qui structure, automatise et valorise vos accompagnements.
      </p>
      <a href={DEMO_HREF} class="gnb-btn gnb-btn--primary">Réserver une démo</a>
    </div>

    <nav class="site-footer__cols" aria-label="Plan du site">
      {
        footerNav.map((group) => (
          <div class="site-footer__col">
            <h2 class="site-footer__col-title">{group.label}</h2>
            <ul>
              {group.children?.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="site-footer__bottom">
    <div class="site-footer__bottom-inner">
      <p class="site-footer__legal-mentions">
        Gonabi — <span class="gnb-todo">[À FOURNIR]</span> forme juridique, capital, RCS, siège social.
        Voir les <a href="/mentions-legales.html">mentions légales</a>.
      </p>
      <nav class="site-footer__legal" aria-label="Liens légaux">
        {legalNav.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
      <p class="site-footer__copyright">Copyright © {year} Gonabi. Tous droits réservés.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--gnb-cream);
    border-top: 1px solid var(--gnb-border-soft);
  }

  .site-footer__inner {
    max-width: var(--gnb-container);
    margin-inline: auto;
    padding: var(--gnb-space-12) 5%;
    display: grid;
    grid-template-columns: minmax(240px, 1fr) 3fr;
    gap: var(--gnb-space-12);
  }

  .site-footer__brand img {
    height: 44px;
    width: auto;
    margin-bottom: var(--gnb-space-4);
  }

  .site-footer__tagline {
    font-size: 0.9rem;
    color: var(--gnb-text-muted);
    line-height: var(--gnb-leading-relaxed);
    margin-bottom: var(--gnb-space-6);
    max-width: 30ch;
  }

  .site-footer__cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--gnb-space-8);
  }

  .site-footer__col-title {
    font-family: var(--gnb-font-body);
    font-size: var(--gnb-text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--gnb-text);
    margin-bottom: var(--gnb-space-4);
  }

  .site-footer__col ul {
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  .site-footer__col a {
    font-size: var(--gnb-text-sm);
    color: var(--gnb-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .site-footer__col a:hover {
    color: var(--gnb-red);
  }

  .site-footer__bottom {
    border-top: 1px solid var(--gnb-border-soft);
  }

  .site-footer__bottom-inner {
    max-width: var(--gnb-container);
    margin-inline: auto;
    padding: var(--gnb-space-6) 5%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--gnb-space-4);
  }

  .site-footer__legal-mentions,
  .site-footer__copyright {
    font-size: var(--gnb-text-sm);
    color: var(--gnb-text-muted);
  }

  .site-footer__legal-mentions {
    flex-basis: 100%;
  }

  .site-footer__legal-mentions a {
    color: var(--gnb-text-muted);
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gnb-space-6);
  }

  .site-footer__legal a {
    font-size: var(--gnb-text-sm);
    color: var(--gnb-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .site-footer__legal a:hover {
    color: var(--gnb-text);
  }

  @media (max-width: 1024px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      gap: var(--gnb-space-8);
    }

    .site-footer__cols {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .site-footer__cols {
      grid-template-columns: 1fr;
    }
  }
</style>
