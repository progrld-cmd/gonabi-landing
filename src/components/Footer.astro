---
import { footerNav, legalNav, DEMO_HREF } from '../data/navigation';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href="/" aria-label="Gonabi — Accueil">
          <img
            src="/assets/logos/Gonabi_Logo_Horizontal.png"
            alt="Gonabi"
            width="150"
            height="40"
            loading="lazy"
          />
        </a>
        <p class="site-footer__tagline">
          La plateforme qui structure, automatise et valorise vos accompagnements.
        </p>
        <a href={DEMO_HREF} class="btn btn--secondary">Réserver une démo</a>
      </div>

      <nav class="site-footer__cols" aria-label="Plan du site">
        {
          footerNav.map((group) => (
            <div class="site-footer__col">
              <h2 class="eyebrow">{group.label}</h2>
              <ul>
                {group.children?.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__mentions">
        Gonabi — <span class="gnb-todo">[À FOURNIR]</span> forme juridique, capital, RCS, siège
        social. Voir les <a href="/mentions-legales.html" class="link">mentions légales</a>.
      </p>

      <nav class="site-footer__legal" aria-label="Liens légaux">
        {legalNav.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>

      <p class="site-footer__copyright">© {year} Gonabi. Tous droits réservés.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--paper-light);
    border-top: var(--border-hairline) solid var(--rule-strong);
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: minmax(240px, 1fr) 2.4fr;
    gap: var(--space-16);
    padding-block: var(--section-y-tight);
  }

  .site-footer__brand img {
    height: 34px;
    width: auto;
    margin-bottom: var(--space-8);
  }

  .site-footer__tagline {
    font-size: var(--size-small);
    line-height: var(--leading-body);
    color: var(--text-muted);
    max-width: 32ch;
    margin-bottom: var(--space-8);
  }

  .site-footer__cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-8);
  }

  .site-footer__col h2 {
    margin-bottom: var(--space-4);
  }

  .site-footer__col ul {
    list-style: none;
    display: grid;
    gap: 10px;
  }

  .site-footer__col a {
    font-size: var(--size-small);
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--duration) var(--ease);
  }

  .site-footer__col a:hover {
    color: var(--accent-deep);
  }

  .site-footer__bottom {
    border-top: var(--border-hairline) solid var(--rule);
    padding-block: var(--space-8);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .site-footer__mentions,
  .site-footer__copyright {
    font-size: 13px;
    color: var(--text-muted);
  }

  .site-footer__mentions {
    flex-basis: 100%;
    margin-bottom: var(--space-4);
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  .site-footer__legal a {
    font-size: 13px;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--duration) var(--ease);
  }

  .site-footer__legal a:hover {
    color: var(--text);
  }

  @media (max-width: 1024px) {
    .site-footer__top {
      grid-template-columns: 1fr;
      gap: var(--space-16);
    }

    .site-footer__cols {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .site-footer__cols {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
